# Copy this file to .env and adjust as needed.
# If this is not set, or the backend isn't reachable, the app automatically
# falls back to its bundled offline demo dataset -- no backend is required
# to run the app.

# Local development (backend running on the same machine, web browser):
VITE_API_BASE_URL=http://localhost:8000

# Android emulator (10.0.2.2 is a special alias for your host machine's localhost):
# VITE_API_BASE_URL=http://10.0.2.2:8000

# Physical Android device on the same Wi-Fi network (use your computer's LAN IP):
# VITE_API_BASE_URL=http://192.168.1.5:8000
